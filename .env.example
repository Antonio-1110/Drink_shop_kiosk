# Settings for `docker compose` (docker-compose.yml). Copy to .env and fill in; never commit .env.
# For staging copy .env.staging.example to .env.staging instead. Every setting the backend reads is
# listed in README.md.

# --- which copy this is ---
DEPLOY_NAME=production
# the file the backend containers read their settings from (this one)
ENV_FILE=.env

# --- database (the db container creates it on first start) ---
POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
# long and random, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Django ---
# long and random: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# the domain(s) the API is reached at, comma-separated; keep localhost for testing on this computer
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 once Caddy (the https profile) or the hosting platform serves the site over HTTPS
DJANGO_HTTPS=
# web server processes; 2 suits a 1-2 GB server
WEB_CONCURRENCY=2
# proxies in front that add X-Forwarded-For: 1 behind Caddy (the https profile) or a platform's load
# balancer, 0 if visitors reach the backend directly. Rate limits depend on it being right.
DJANGO_NUM_PROXIES=1
# plain or json (one JSON object per log line, for a log service)
# LOG_FORMAT=plain
# a request slower than this (ms) or running more database queries than this is logged as a warning
# SLOW_REQUEST_MS=1000
# SLOW_REQUEST_QUERIES=60
# staff sign-in lockout: wrong passwords from one address within the window
# ADMIN_LOGIN_ATTEMPTS=10
# ADMIN_LOGIN_WINDOW_MINUTES=15
# 1 once the kiosk and the app send order tokens on payment/status calls (see README.md)
# REQUIRE_ORDER_TOKEN=

# --- HTTPS on a server (docker compose --profile https up -d) ---
# the domain pointed at this server, e.g. api.example.sg
SITE_ADDRESS=
# staging's domain, when staging runs on the same server
STAGING_SITE_ADDRESS=

# --- where the web server listens on this computer ---
# 127.0.0.1 keeps it private (Caddy reaches it over Docker's network)
WEB_BIND=127.0.0.1
WEB_PORT=8000

# --- backups (the backup service) ---
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups/production

# --- payments (lines starting with # use the default) ---
# PAYNOW_PROXY_TYPE=UEN
# the company's UEN; required in production
PAYNOW_PROXY_VALUE=
# PAYNOW_MERCHANT_NAME=
# paynow, sandbox, stripe_paynow, stripe_grabpay (see docs/payments.md)
# PAYMENT_METHODS=paynow
# this server's public address, e.g. https://api.example.sg (used in payment QR codes)
# PUBLIC_BASE_URL=
# Stripe: test keys (sk_test_...) move no money; a live key also needs STRIPE_LIVE=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- machines ---
# 1 hands over paid orders without a machine making them; leave off once machines report progress
# MACHINE_SIMULATOR=

# --- staff alert emails (daily order check) ---
# STAFF_ALERT_EMAILS=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
