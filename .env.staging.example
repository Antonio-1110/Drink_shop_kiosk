# Staging: a second copy of the backend with its own database, for trying changes before they
# reach the shops. Copy to .env.staging, fill in, and run:
#   docker compose -p kiosk-staging --env-file .env.staging up -d --build
# It loads the demo shops and menu, and hands over orders without a drink machine.

DEPLOY_NAME=staging
ENV_FILE=.env.staging

POSTGRES_DB=kiosk_staging
POSTGRES_USER=kiosk
# not the same as production's
POSTGRES_PASSWORD=

# not the same as production's
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=
WEB_CONCURRENCY=1

# next to production on the same server: a different port. Production's Caddy serves it at
# STAGING_SITE_ADDRESS (set that in production's .env).
WEB_BIND=127.0.0.1
WEB_PORT=8001

BACKUP_AT=03:45
BACKUP_KEEP_DAYS=7

# demo shops and menu in an empty database; machine simulator; the fake test bank for payments
# (no money moves) and a dummy PayNow account
SEED_DEMO=1
MACHINE_SIMULATOR=1
PAYMENTS_SANDBOX=1
# with Stripe test keys (sk_test_...) you can also try stripe_paynow / stripe_grabpay here
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PAYNOW_PROXY_VALUE=T00LL0000A
PAYNOW_MERCHANT_NAME=Kiosk Staging
